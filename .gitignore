# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Testing
.pytest_cache/

# Virtual environments
venv/
.venv/

# Notebooks
.ipynb_checkpoints/

# macOS
.DS_Store

# Third-party arXiv material (papers/): kept locally, not distributed
# (arXiv default license does not permit third-party redistribution).
# papers/README.md is tracked and lists the fetch commands.
papers/*
!papers/README.md
!papers/fetch.sh

# Claude Code agent worktrees and local permission settings (session-local,
# never part of the repo)
.claude/worktrees/
.claude/settings.local.json
*.json.tmp

# Logged reproduction snapshots (can be large)
validation-runs/
